#!/usr/bin/env bash

set -e

# Unset conflicting Android prefs environment variable if present
unset ANDROID_PREFS_ROOT

# Auto-detect JAVA_HOME if not set in environment
if [ -z "$JAVA_HOME" ]; then
    if command -v java >/dev/null 2>&1; then
        JAVA_BIN="$(which java)"
        JAVA_REAL="$(readlink -f "$JAVA_BIN" 2>/dev/null || echo "$JAVA_BIN")"
        export JAVA_HOME="$(dirname $(dirname "$JAVA_REAL"))"
    fi
fi

if [ -n "$JAVA_HOME" ] && [[ ":$PATH:" != *":$JAVA_HOME/bin:"* ]]; then
    export PATH="$JAVA_HOME/bin:$PATH"
fi

echo "=========================================="
echo " Running Git pre-push hook..."
echo "=========================================="

# 1. Run detekt with auto-correct to fix simple issues (formatting, unused imports) and check code style
echo "[1/3] Running detekt with auto-correct..."
if ! ./gradlew detekt --auto-correct; then
    echo "❌ Detekt check failed! Please fix the reported issues before pushing."
    exit 1
fi
echo "✅ Detekt checks passed."

# 2. Run screenshot tests validation
echo "[2/3] Running validateDebugScreenshotTest..."
if ! ./gradlew validateDebugScreenshotTest; then
    echo "❌ Screenshot tests validation failed!"
    exit 1
fi
echo "✅ Screenshot tests validation passed."

# 3. Run unit tests
echo "[3/3] Running unit tests..."
if ! ./gradlew test; then
    echo "❌ Unit tests failed!"
    exit 1
fi
echo "✅ Unit tests passed."

echo "=========================================="
echo " All pre-push checks passed successfully!"
echo "=========================================="
exit 0
