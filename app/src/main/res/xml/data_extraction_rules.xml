<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude local database files -->
        <exclude domain="database" path="aureole_app_database.db"/>
        <exclude domain="database" path="aureole_app_database.db-wal"/>
        <exclude domain="database" path="aureole_app_database.db-shm"/>
        <!-- Exclude application shared preferences -->
        <exclude domain="sharedpref" path="aureole_folders_prefs.xml"/>
        <exclude domain="sharedpref" path="aureole_grid_prefs.xml"/>
        <exclude domain="sharedpref" path="aureole_settings_prefs.xml"/>
        <exclude domain="sharedpref" path="aureole_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- Exclude local database files -->
        <exclude domain="database" path="aureole_app_database.db"/>
        <exclude domain="database" path="aureole_app_database.db-wal"/>
        <exclude domain="database" path="aureole_app_database.db-shm"/>
        <!-- Exclude application shared preferences -->
        <exclude domain="sharedpref" path="aureole_folders_prefs.xml"/>
        <exclude domain="sharedpref" path="aureole_grid_prefs.xml"/>
        <exclude domain="sharedpref" path="aureole_settings_prefs.xml"/>
        <exclude domain="sharedpref" path="aureole_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
