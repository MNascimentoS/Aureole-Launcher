    <exclude domain="sharedpref" path="aureole_folders_prefs.xml"/>
    <exclude domain="sharedpref" path="aureole_grid_prefs.xml"/>
    <exclude domain="sharedpref" path="aureole_settings_prefs.xml"/>
    <exclude domain="sharedpref" path="aureole_prefs.xml"/>
</full-backup-content>
